{
	admin off
	auto_https off
}

:{$PORT:3007} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@static path */assets/fonts/* */assets/brand/* */assets/images/*
	header @static Cache-Control "public, max-age=604800"

	@code path *.css *.js
	header @code Cache-Control "no-cache"

	file_server

	handle_errors {
		@uk expression `{err.status_code} == 404 && {path}.startsWith("/uk/")`
		@en expression `{err.status_code} == 404 && {path}.startsWith("/en/")`
		@ru expression `{err.status_code} == 404`
		handle @uk {
			rewrite * /uk/404.html
			file_server
		}
		handle @en {
			rewrite * /en/404.html
			file_server
		}
		handle @ru {
			rewrite * /404.html
			file_server
		}
	}
}
